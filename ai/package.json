{
  "name": "gm-ai",
  "private": true,
  "type": "module",
  "description": "Optional in-browser assistant for the Guide: request text → layout DSL. Data, training and eval tooling.",
  "scripts": {
    "gen": "bun data/gen.ts",
    "paraphrase": "bun data/paraphrase.ts",
    "annotate": "bun data/paraphrase.ts --annotate eval/real.jsonl",
    "build-data": "bun data/build.ts",
    "eval": "bun eval/run.ts",
    "oracle": "bun eval/run.ts --oracle --set dev",
    "test": "bun test test"
  },
  "devDependencies": {
    "@huggingface/transformers": "3.7.6"
  }
}
