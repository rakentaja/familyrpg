  "recipes": {
    "cabin": {
      "names": [
        "cabin interior",
        "cosy cabin",
        "cozy cabin",
        "log cabin"
      ],
      "body": [
        "scene add \"Cosy Cabin\" 8x8 ground:floor",
        "add prop:fireplace side:n",
        "add prop:rocking_horse near:prop:fireplace",
        "add 2 prop:shelves side:w",
        "add 3 prop:crate corner:se cluster",
        "add prop:log_pile near:prop:fireplace"
      ]
    },
    "workshop": {
      "names": [
        "workshop",
        "toy workshop",
        "toy factory"
      ],
      "body": [
        "scene add \"Toy Workshop\" 10x10 ground:floor",
        "add prop:workshop_door side:n",
        "add 3 prop:workbench center",
        "add 3 prop:shelves side:w",
        "add 2 prop:toy_pile spread",
        "add prop:toy_train side:e"
      ]
    },
    "forest_path": {
      "names": [
        "forest path",
        "forest",
        "woods",
        "snowy forest",
        "forest trail"
      ],
      "body": [
        "scene add \"Forest Path\" 10x14 ground:snow",
        "add 4 prop:pine_tree side:w",
        "add 4 prop:pine_tree side:e",
        "add 2 prop:snow_drift spread",
        "add prop:signpost center"
      ]
    },
    "frozen_pond": {
      "names": [
        "frozen pond",
        "ice lake",
        "skating pond"
      ],
      "body": [
        "scene add \"Frozen Pond\" 12x12 ground:ice",
        "add prop:water_hole center",
        "add 2 prop:cracked_ice_1 spread",
        "add 3 prop:pine_tree side:n",
        "add prop:bench side:s"
      ]
    },
    "ice_cave": {
      "names": [
        "ice cave",
        "troll cave",
        "frozen cave"
      ],
      "body": [
        "scene add \"Ice Cave\" 10x12 ground:ice",
        "add prop:cave_entrance side:s",
        "add 3 prop:cave_wall side:w",
        "add 3 prop:cave_wall side:e",
        "add 2 prop:icicles spread",
        "add 2 prop:rock spread"
      ]
    },
    "rooftops": {
      "names": [
        "rooftops",
        "rooftop",
        "roofs",
        "rooftop run"
      ],
      "body": [
        "scene add \"Rooftops\" 9x12 ground:roof",
        "add 2 prop:chimney spread",
        "add prop:roof_gap_edge center",
        "add 2 prop:snow_drift spread"
      ]
    },
    "village_square": {
      "names": [
        "village square",
        "village",
        "town square",
        "market"
      ],
      "body": [
        "scene add \"Village Square\" 12x12 ground:snow",
        "add prop:great_tree center",
        "add 4 prop:lamp_post around:prop:great_tree",
        "add prop:cocoa_stand side:e",
        "add 2 prop:bench side:s",
        "add prop:mailbox side:w"
      ]
    },
    "boss_arena": {
      "names": [
        "boss arena",
        "boss fight",
        "troll fight",
        "final fight",
        "showdown"
      ],
      "body": [
        "scene add \"Troll's Lair\" 12x12 ground:ice",
        "add prop:boss_ice_wall side:n",
        "add 4 prop:rock spread",
        "add 2 prop:icicles side:e",
        "add foe:grumbleweed side:n"
      ]
    }
  },
